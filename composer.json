{
    "name": "localhub/panel-laragon",
    "description": "LocalHub - a Cyberpunk-themed developer dashboard for Laragon that lists local projects sorted by activity",
    "type": "project",
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
